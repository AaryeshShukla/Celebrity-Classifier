{
  "version": 2,
  "builds": [
    { "src": "server/server.py", "use": "@vercel/python" },
    { "src": "server/index.html", "use": "@vercel/static" },
    { "src": "server/app.js", "use": "@vercel/static" },
    { "src": "server/images/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/classify_image", "dest": "server/server.py" },
    { "src": "/app.js", "dest": "server/app.js" },
    { "src": "/images/(.*)", "dest": "server/images/$1" },
    { "src": "/", "dest": "server/index.html" },
    { "src": "/(.*)", "dest": "server/$1" }
  ]
}
